# Zenix backend environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file at backend/zenix.db
# For production use PostgreSQL: postgresql://user:pass@host/dbname
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── NVD API ───────────────────────────────────────────────────────────────────
# Free key from: https://nvd.nist.gov/developers/request-an-api-key
# Without a key: 5 req/30s (slow). With a key: 50 req/30s (recommended).
NVD_API_KEY=

# ── Upload ────────────────────────────────────────────────────────────────────
# Directory for temporary SBOM file storage (created automatically if absent)
UPLOAD_FOLDER=uploads
