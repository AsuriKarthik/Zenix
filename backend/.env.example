# Zenix backend environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zenix_permanent_session_secret_key_839210948

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file at backend/zenix.db
# For production use PostgreSQL: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///zenix.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── NVD API ───────────────────────────────────────────────────────────────────
# Free key from: https://nvd.nist.gov/developers/request-an-api-key
# Without a key: 5 req/30s (slow). With a key: 50 req/30s (recommended).
NVD_API_KEY=

# ── Shodan Threat Intelligence ────────────────────────────────────────────────
# API key from: https://account.shodan.io
SHODAN_API_KEY=

# ── VirusTotal Threat Intelligence ────────────────────────────────────────────
# API key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ── SMTP Email Dispatch (2FA / OTP) ───────────────────────────────────────────
# Real SMTP credentials. If blank, OTP is securely saved to logs/security_audit.log
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@zenix.security

# ── Upload ────────────────────────────────────────────────────────────────────
# Directory for temporary SBOM file storage (created automatically if absent)
UPLOAD_FOLDER=uploads

